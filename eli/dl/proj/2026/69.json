      "attributes": {
        "eventTitle": {
          "rdf:langString": {
            "de": [
              "Verordnung über die Meldestelle für lebenswichtige Medizinprodukte"
            ],
            "it": [
              "Ordinanza sul centro di notifica per i dispositivi medici d’importanza vitale"
            ],
            "fr": [
              "Ordonnance sur le bureau de notification pour les dispositifs médicaux vitaux"
            ]
          }
        },
        "eventDescription": {
          "rdf:langString": {
            "de": [
              "Mit der Vorlage setzt das WBF den Auftrag des Bundesrats zur Einführung eines Monitorings der Versorgungslage bei lebenswichtigen Medizinprodukten um."
            ],
            "it": [
              "Con questo progetto die legge, il DEFR attua il mandato del Consiglio federale volto a introdurre un sistema di monitoraggio della situazione dell’approvvigionamento di dispositivi medici d’importanza vitale."
            ],
            "fr": [
              "Grâce à ce projet, le DEFR met en œuvre le mandat du Conseil fédéral visant à instaurer un suivi de la situation des approvisionnements en dispositifs médicaux vitaux."
            ]
          }
        },
        "eventId": {
          "xsd:string": "proj/2026/69/cons_1"
